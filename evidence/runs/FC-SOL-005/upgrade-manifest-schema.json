{
  "$defs": {
    "hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "https://foundrypay.dev/schemas/channels/upgrade-manifest-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvals": {
      "items": {
        "maxLength": 44,
        "minLength": 32,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "approved_at": {
      "$ref": "#/$defs/timestamp"
    },
    "authority_members": {
      "items": {
        "maxLength": 44,
        "minLength": 32,
        "type": "string"
      },
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "change_class": {
      "enum": [
        "compatible",
        "versioned",
        "forbidden"
      ]
    },
    "current_account_layout_sha256": {
      "$ref": "#/$defs/hash"
    },
    "current_binary_sha256": {
      "$ref": "#/$defs/hash"
    },
    "current_instruction_registry_sha256": {
      "$ref": "#/$defs/hash"
    },
    "current_program_id": {
      "maxLength": 44,
      "minLength": 32,
      "type": "string"
    },
    "current_protocol_version": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "current_signed_message_registry_sha256": {
      "$ref": "#/$defs/hash"
    },
    "earliest_execution_at": {
      "$ref": "#/$defs/timestamp"
    },
    "execution_status": {
      "enum": [
        "not_executed",
        "executed",
        "failed"
      ]
    },
    "lockfile_sha256": {
      "$ref": "#/$defs/hash"
    },
    "manifest_version": {
      "const": 1
    },
    "proposed_account_layout_sha256": {
      "$ref": "#/$defs/hash"
    },
    "proposed_binary_sha256": {
      "$ref": "#/$defs/hash"
    },
    "proposed_instruction_registry_sha256": {
      "$ref": "#/$defs/hash"
    },
    "proposed_program_id": {
      "maxLength": 44,
      "minLength": 32,
      "type": "string"
    },
    "proposed_protocol_version": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "proposed_signed_message_registry_sha256": {
      "$ref": "#/$defs/hash"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "threshold": {
      "minimum": 2,
      "type": "integer"
    },
    "toolchain": {
      "minLength": 1,
      "type": "string"
    },
    "verification_status": {
      "enum": [
        "not_performed",
        "passed",
        "failed"
      ]
    }
  },
  "required": [
    "manifest_version",
    "change_class",
    "current_program_id",
    "proposed_program_id",
    "current_protocol_version",
    "proposed_protocol_version",
    "current_binary_sha256",
    "proposed_binary_sha256",
    "source_commit",
    "toolchain",
    "lockfile_sha256",
    "current_account_layout_sha256",
    "proposed_account_layout_sha256",
    "current_instruction_registry_sha256",
    "proposed_instruction_registry_sha256",
    "current_signed_message_registry_sha256",
    "proposed_signed_message_registry_sha256",
    "approved_at",
    "earliest_execution_at",
    "authority_members",
    "threshold",
    "approvals",
    "execution_status",
    "verification_status"
  ],
  "title": "Foundry Channels Upgrade Manifest v1",
  "type": "object"
}
