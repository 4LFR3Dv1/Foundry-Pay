{
  "registry": "foundry.channels.domains",
  "version": "1.0.0",
  "matching": "exact",
  "domains": [
    {
      "domain": "foundry.channels.voucher",
      "object_type": "channel_voucher",
      "profile_id": "signed-payload-v1",
      "schema": "../channel-voucher.schema.json",
      "version": "1.0.0",
      "authority": "sender",
      "binding": {"kind": "explicit_field", "field": "domain"},
      "required_separation_fields": ["protocol_version", "environment", "network", "genesis_hash", "program_id", "channel_id", "channel_account", "epoch", "sequence", "sender", "recipient_claim_pubkey", "mint", "expires_at"],
      "result_hash_field": "voucher_hash",
      "excluded_fields": ["voucher_hash", "sender_signature"]
    },
    {
      "domain": "foundry.channels.recipient-binding",
      "object_type": "recipient_binding",
      "profile_id": "signed-payload-v1",
      "schema": "../recipient-binding.schema.json",
      "version": "1.0.0",
      "authority": "claim_key+destination_wallet",
      "binding": {"kind": "explicit_field", "field": "domain"},
      "required_separation_fields": ["protocol_version", "environment", "network", "genesis_hash", "program_id", "channel_id", "channel_account", "epoch", "claim_id", "claim_pubkey", "voucher_hash", "mint", "destination_wallet", "binding_nonce", "expires_at"],
      "result_hash_field": "binding_hash",
      "excluded_fields": ["binding_hash", "claim_key_signature", "destination_wallet_signature"]
    },
    {
      "domain": "foundry.channels.recipient-binding-journal",
      "object_type": "recipient_binding_journal_scope",
      "profile_id": "canonical-record-v1",
      "schema": "registry-objects.v1.schema.json#/$defs/RecipientBindingJournalScope",
      "version": "1.0.0",
      "authority": "reference_journal",
      "binding": {"kind": "explicit_field", "field": "domain"},
      "required_separation_fields": ["protocol_version", "environment", "network", "genesis_hash", "program_id", "channel_id", "channel_account", "epoch", "claim_id", "claim_pubkey", "voucher_hash", "mint"],
      "result_hash_field": "journal_domain_hash",
      "excluded_fields": []
    },
    {
      "domain": "foundry.channels.voucher-ledger-scope",
      "object_type": "voucher_ledger_scope",
      "profile_id": "canonical-record-v1",
      "schema": "registry-objects.v1.schema.json#/$defs/VoucherLedgerScope",
      "version": "1.0.0",
      "authority": "reference_voucher_ledger",
      "binding": {"kind": "explicit_field", "field": "domain"},
      "required_separation_fields": ["protocol_version", "environment", "network", "genesis_hash", "program_id", "channel_id", "channel_account", "epoch", "sender", "recipient_claim_pubkey", "mint"],
      "result_hash_field": "domain_key",
      "excluded_fields": []
    },
    {
      "domain": "foundry.channels.channel-snapshot",
      "object_type": "channel",
      "profile_id": "canonical-record-v1",
      "schema": "../channel.schema.json",
      "version": "1.0.0",
      "authority": "caller_supplied_snapshot_observation",
      "binding": {"kind": "type_and_protocol_version", "type": "channel", "protocol_version": "1.0.0"},
      "required_separation_fields": ["environment", "network", "genesis_hash", "program_id", "channel_id", "channel_account", "epoch", "sender", "recipient_claim_pubkey", "mint"],
      "result_hash_field": "channel_snapshot_hash",
      "excluded_fields": []
    },
    {
      "domain": "foundry.channels.settlement-request",
      "object_type": "settlement_request",
      "profile_id": "canonical-record-v1",
      "schema": "../settlement.schema.json#/$defs/ReferenceSettlementRequest",
      "version": "1.0.0",
      "authority": "foundry_pay_economic_intent",
      "binding": {"kind": "type_and_protocol_version", "type": "settlement_request", "protocol_version": "1.0.0"},
      "required_separation_fields": ["environment", "network", "genesis_hash", "program_id", "channel_id", "channel_account", "epoch", "mint", "recipient_wallet", "expires_at"],
      "result_hash_field": "request_hash",
      "excluded_fields": []
    },
    {
      "domain": "foundry.channels.settlement-execution-commitment",
      "object_type": "settlement_execution_commitment",
      "profile_id": "canonical-record-v1",
      "schema": "../settlement.schema.json#/$defs/SettlementExecutionCommitment",
      "version": "1.0.0",
      "authority": "technical_executor_commitment",
      "binding": {"kind": "type_and_protocol_version", "type": "settlement_execution_commitment", "protocol_version": "1.0.0"},
      "required_separation_fields": ["settlement_request_hash", "execution_request_id", "execution_commitment_hash", "prepared_message_hash", "executor_id", "expected_signer", "expires_at"],
      "result_hash_field": "commitment_hash",
      "excluded_fields": []
    },
    {
      "domain": "foundry.channels.settlement-authorization",
      "object_type": "execution_authorization",
      "profile_id": "canonical-record-v1",
      "schema": "../../../packages/external-execution-protocol/schemas/external-execution-agent.v1.schema.json#/$defs/ExecutionAuthorization",
      "version": "1.0.0",
      "authority": "external_authorization_verifier",
      "binding": {"kind": "type_and_protocol_version", "type": "execution_authorization", "protocol_version": "1.0.0"},
      "required_separation_fields": ["authorization_id", "execution_request_id", "execution_commitment_hash", "prepared_message_hash", "signer", "expires_at"],
      "result_hash_field": "authorization_hash",
      "excluded_fields": []
    },
    {
      "domain": "foundry.channels.settlement-observation",
      "object_type": "settlement_observation",
      "profile_id": "self-hashed-record-v1",
      "schema": "../settlement.schema.json#/$defs/SettlementObservation",
      "version": "1.0.0",
      "authority": "independent_observation_provider",
      "binding": {"kind": "type_and_protocol_version", "type": "settlement_observation", "protocol_version": "1.0.0"},
      "required_separation_fields": ["channel_id", "channel_account", "epoch", "mint", "destination", "transaction_signature"],
      "result_hash_field": "observation_hash",
      "own_hash_field": "observation_hash",
      "excluded_fields": ["observation_hash"]
    },
    {
      "domain": "foundry.channels.reconciled-settlement-receipt",
      "object_type": "reconciled_settlement_receipt",
      "profile_id": "self-hashed-record-v1",
      "schema": "../settlement.schema.json#/$defs/ReconciledSettlementReceipt",
      "version": "1.0.0",
      "authority": "reference_reconciler",
      "binding": {"kind": "type_and_protocol_version", "type": "reconciled_settlement_receipt", "protocol_version": "1.0.0"},
      "required_separation_fields": ["settlement_request_hash", "channel_id", "channel_account", "epoch", "mint", "destination", "transaction_signature", "observation_hashes"],
      "result_hash_field": "receipt_hash",
      "own_hash_field": "receipt_hash",
      "excluded_fields": ["receipt_hash"],
      "canonical_sets": [{"field": "observation_hashes", "sort": "lexicographic_utf8", "unique": true}]
    },
    {
      "domain": "foundry.channels.recovery-record",
      "object_type": "settlement_recovery_record",
      "profile_id": "self-hashed-record-v1",
      "schema": "../settlement.schema.json#/$defs/SettlementRecoveryRecord",
      "version": "1.0.0",
      "authority": "reference_recovery_runtime",
      "binding": {"kind": "type_and_protocol_version", "type": "settlement_recovery_record", "protocol_version": "1.0.0"},
      "required_separation_fields": ["settlement_id", "attempt", "outcome", "observed_at"],
      "result_hash_field": "recovery_hash",
      "own_hash_field": "recovery_hash",
      "excluded_fields": ["recovery_hash"]
    },
    {
      "domain": "foundry.channels.settlement-journal-entry",
      "object_type": "settlement_journal_entry",
      "profile_id": "journal-chain-v1",
      "schema": "../settlement.schema.json#/$defs/SettlementJournalEntry",
      "version": "1.0.0",
      "authority": "durable_settlement_journal",
      "binding": {"kind": "type_and_protocol_version", "type": "settlement_journal_entry", "protocol_version": "1.0.0"},
      "required_separation_fields": ["settlement_id", "sequence", "event_type", "previous_event_hash", "recorded_at"],
      "result_hash_field": "event_hash",
      "own_hash_field": "event_hash",
      "excluded_fields": ["event_hash"]
    },
    {
      "domain": "foundry.channels.closure-request",
      "object_type": "channel_closure_request",
      "profile_id": "self-hashed-record-v1",
      "schema": "../channel-closure.schema.json#/$defs/ChannelClosureRequest",
      "version": "1.0.0",
      "authority": "sender_close_intent",
      "binding": {"kind": "type_and_protocol_version", "type": "channel_closure_request", "protocol_version": "1.0.0"},
      "required_separation_fields": ["domain", "channel", "closure_id", "claim_deadline"],
      "result_hash_field": "request_hash",
      "own_hash_field": "request_hash",
      "excluded_fields": ["request_hash"]
    },
    {
      "domain": "foundry.channels.closure-request-snapshot",
      "object_type": "closure_snapshot_at_request",
      "profile_id": "self-hashed-record-v1",
      "schema": "../channel-closure.schema.json#/$defs/ClosureSnapshotAtRequest",
      "version": "1.0.0",
      "authority": "reference_closure_runtime",
      "binding": {"kind": "type_and_protocol_version", "type": "closure_snapshot_at_request", "protocol_version": "1.0.0"},
      "required_separation_fields": ["domain", "channel", "closure_id", "closure_request_hash", "latest_activated_sequence", "latest_activated_voucher_hash"],
      "result_hash_field": "request_snapshot_hash",
      "own_hash_field": "request_snapshot_hash",
      "excluded_fields": ["request_snapshot_hash"]
    },
    {
      "domain": "foundry.channels.closure-freeze",
      "object_type": "closure_snapshot_at_freeze",
      "profile_id": "self-hashed-record-v1",
      "schema": "../channel-closure.schema.json#/$defs/ClosureSnapshotAtFreeze",
      "version": "1.0.0",
      "authority": "reference_closure_runtime",
      "binding": {"kind": "type_and_protocol_version", "type": "closure_snapshot_at_freeze", "protocol_version": "1.0.0"},
      "required_separation_fields": ["domain", "channel", "closure_id", "request_snapshot_hash", "latest_activated_sequence", "latest_activated_voucher_hash", "frozen_at"],
      "result_hash_field": "freeze_snapshot_hash",
      "own_hash_field": "freeze_snapshot_hash",
      "excluded_fields": ["freeze_snapshot_hash"]
    },
    {
      "domain": "foundry.channels.refund-request",
      "object_type": "refund_request",
      "profile_id": "self-hashed-record-v1",
      "schema": "../channel-closure.schema.json#/$defs/RefundRequest",
      "version": "1.0.0",
      "authority": "sender_refund_intent",
      "binding": {"kind": "type_and_protocol_version", "type": "refund_request", "protocol_version": "1.0.0"},
      "required_separation_fields": ["domain", "channel", "closure_id", "refund_id", "destination", "freeze_snapshot_hash", "expires_at"],
      "result_hash_field": "request_hash",
      "own_hash_field": "request_hash",
      "excluded_fields": ["request_hash"]
    },
    {
      "domain": "foundry.channels.refund-projection",
      "object_type": "refund_projection",
      "profile_id": "self-hashed-record-v1",
      "schema": "../channel-closure.schema.json#/$defs/RefundProjection",
      "version": "1.0.0",
      "authority": "reference_refund_runtime",
      "binding": {"kind": "type_and_protocol_version", "type": "refund_projection", "protocol_version": "1.0.0"},
      "required_separation_fields": ["refund_request_hash", "freeze_snapshot_hash", "requested_base_units", "projected_at"],
      "result_hash_field": "projection_hash",
      "own_hash_field": "projection_hash",
      "excluded_fields": ["projection_hash"]
    },
    {
      "domain": "foundry.channels.refund-execution-commitment",
      "object_type": "refund_execution_commitment",
      "profile_id": "canonical-record-v1",
      "schema": "../channel-closure.schema.json#/$defs/RefundExecutionCommitment",
      "version": "1.0.0",
      "authority": "technical_executor_commitment",
      "binding": {"kind": "type_and_protocol_version", "type": "refund_execution_commitment", "protocol_version": "1.0.0"},
      "required_separation_fields": ["refund_request_hash", "refund_projection_hash", "execution_request_id", "execution_commitment_hash", "prepared_message_hash", "executor_id", "expected_signer", "expires_at"],
      "result_hash_field": "commitment_hash",
      "excluded_fields": []
    },
    {
      "domain": "foundry.channels.technical-refund-receipt",
      "object_type": "technical_refund_receipt",
      "profile_id": "self-hashed-record-v1",
      "schema": "../channel-closure.schema.json#/$defs/TechnicalRefundReceipt",
      "version": "1.0.0",
      "authority": "technical_executor_evidence",
      "binding": {"kind": "type_and_protocol_version", "type": "technical_refund_receipt", "protocol_version": "1.0.0"},
      "required_separation_fields": ["refund_id", "refund_request_hash", "execution_request_id", "execution_commitment_hash", "observed_at"],
      "result_hash_field": "receipt_hash",
      "own_hash_field": "receipt_hash",
      "excluded_fields": ["receipt_hash"]
    },
    {
      "domain": "foundry.channels.refund-observation",
      "object_type": "channel_refund_observation",
      "profile_id": "self-hashed-record-v1",
      "schema": "../channel-closure.schema.json#/$defs/ChannelRefundObservation",
      "version": "1.0.0",
      "authority": "independent_observation_provider",
      "binding": {"kind": "type_and_protocol_version", "type": "channel_refund_observation", "protocol_version": "1.0.0"},
      "required_separation_fields": ["domain", "channel_id", "channel_account", "epoch", "mint", "destination", "refund_id", "transaction_signature"],
      "result_hash_field": "observation_hash",
      "own_hash_field": "observation_hash",
      "excluded_fields": ["observation_hash"]
    },
    {
      "domain": "foundry.channels.reconciled-refund",
      "object_type": "reconciled_channel_refund",
      "profile_id": "self-hashed-record-v1",
      "schema": "../channel-closure.schema.json#/$defs/ReconciledChannelRefund",
      "version": "1.0.0",
      "authority": "reference_reconciler",
      "binding": {"kind": "type_and_protocol_version", "type": "reconciled_channel_refund", "protocol_version": "1.0.0"},
      "required_separation_fields": ["domain", "channel", "refund_id", "refund_request_hash", "transaction_signature", "observation_hashes"],
      "result_hash_field": "receipt_hash",
      "own_hash_field": "receipt_hash",
      "excluded_fields": ["receipt_hash"],
      "canonical_sets": [{"field": "observation_hashes", "sort": "lexicographic_utf8", "unique": true}]
    },
    {
      "domain": "foundry.channels.epoch-transition-eligibility",
      "object_type": "epoch_transition_eligibility",
      "profile_id": "self-hashed-record-v1",
      "schema": "../channel-closure.schema.json#/$defs/EpochTransitionEligibility",
      "version": "1.0.0",
      "authority": "reference_closure_runtime",
      "binding": {"kind": "type_and_protocol_version", "type": "epoch_transition_eligibility", "protocol_version": "1.0.0"},
      "required_separation_fields": ["domain", "channel_id", "channel_account", "previous_epoch", "next_epoch", "previous_final_closure_hash"],
      "result_hash_field": "eligibility_hash",
      "own_hash_field": "eligibility_hash",
      "excluded_fields": ["eligibility_hash"]
    },
    {
      "domain": "foundry.channels.refund-journal-entry",
      "object_type": "refund_journal_entry",
      "profile_id": "journal-chain-v1",
      "schema": "../channel-closure.schema.json#/$defs/RefundJournalEntry",
      "version": "1.0.0",
      "authority": "durable_refund_journal",
      "binding": {"kind": "type_and_protocol_version", "type": "refund_journal_entry", "protocol_version": "1.0.0"},
      "required_separation_fields": ["refund_id", "sequence", "event_type", "previous_event_hash", "recorded_at"],
      "result_hash_field": "event_hash",
      "own_hash_field": "event_hash",
      "excluded_fields": ["event_hash"]
    }
  ]
}
