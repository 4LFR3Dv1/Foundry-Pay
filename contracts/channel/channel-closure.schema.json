{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.pay/schemas/channel/channel-closure.v1.schema.json",
  "title": "Foundry Channels closure and refund",
  "oneOf": [
    {
      "$ref": "#/$defs/ChannelClosure"
    },
    {
      "$ref": "#/$defs/ChannelRefund"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Pubkey": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ChannelClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "closure_id",
        "channel_id",
        "channel_account",
        "epoch",
        "latest_activated_sequence_at_request",
        "latest_activated_voucher_hash_at_request",
        "activated_authorized_total_at_request_base_units",
        "settled_total_at_request_base_units",
        "outstanding_right_at_request_base_units",
        "activation_allowed_until",
        "pre_deadline_refundable_base_units",
        "requested_at",
        "claim_deadline",
        "state"
      ],
      "properties": {
        "type": {
          "const": "channel_closure"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "closure_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_account": {
          "$ref": "#/$defs/Pubkey"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "latest_activated_sequence_at_request": {
          "type": "integer",
          "minimum": 0
        },
        "latest_activated_voucher_hash_at_request": {
          "$ref": "#/$defs/Hash"
        },
        "activated_authorized_total_at_request_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "settled_total_at_request_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "outstanding_right_at_request_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "activation_allowed_until": {
          "$ref": "#/$defs/Timestamp"
        },
        "pre_deadline_refundable_base_units": {
          "const": "0"
        },
        "requested_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "claim_deadline": {
          "$ref": "#/$defs/Timestamp"
        },
        "state": {
          "enum": [
            "closing",
            "claim_window",
            "ready_to_finalize",
            "closed",
            "blocked",
            "disputed",
            "needs_recovery",
            "needs_review"
          ]
        }
      }
    },
    "ChannelRefund": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "refund_id",
        "channel_id",
        "channel_account",
        "destination",
        "amount_base_units",
        "refunded_total_after_base_units",
        "vault_balance_after_base_units",
        "reason",
        "transaction_signature",
        "observed_at"
      ],
      "properties": {
        "type": {
          "const": "channel_refund"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "refund_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_account": {
          "$ref": "#/$defs/Pubkey"
        },
        "destination": {
          "$ref": "#/$defs/Pubkey"
        },
        "amount_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "refunded_total_after_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "vault_balance_after_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "reason": {
          "enum": [
            "post_claim_window_unallocated",
            "expired_outstanding_right",
            "final_close"
          ]
        },
        "transaction_signature": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    }
  }
}
