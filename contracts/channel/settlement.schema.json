{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.pay/schemas/channel/settlement.v1.schema.json",
  "title": "Foundry Channels settlement objects",
  "oneOf": [
    {
      "$ref": "#/$defs/SettlementRequest"
    },
    {
      "$ref": "#/$defs/SettlementExecution"
    },
    {
      "$ref": "#/$defs/SettlementReceipt"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Pubkey": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "SettlementRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_id",
        "execution_request_id",
        "obligation_id",
        "channel_id",
        "channel_account",
        "epoch",
        "voucher_sequence",
        "voucher_hash",
        "mint",
        "recipient_wallet",
        "requested_amount_base_units",
        "settled_total_before_base_units",
        "settled_total_after_base_units",
        "activated_authorized_total_base_units",
        "requested_at",
        "expires_at"
      ],
      "properties": {
        "type": {
          "const": "settlement_request"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "settlement_id": {
          "$ref": "#/$defs/Identifier"
        },
        "execution_request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "obligation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_account": {
          "$ref": "#/$defs/Pubkey"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "voucher_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "voucher_hash": {
          "$ref": "#/$defs/Hash"
        },
        "mint": {
          "$ref": "#/$defs/Pubkey"
        },
        "recipient_wallet": {
          "$ref": "#/$defs/Pubkey"
        },
        "requested_amount_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "settled_total_before_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "settled_total_after_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "activated_authorized_total_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "requested_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "SettlementExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_id",
        "execution_request_id",
        "economic_plan_hash",
        "prepared_message_hash",
        "execution_commitment_hash",
        "authorization_id",
        "state",
        "updated_at"
      ],
      "properties": {
        "type": {
          "const": "settlement_execution"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "settlement_id": {
          "$ref": "#/$defs/Identifier"
        },
        "execution_request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "economic_plan_hash": {
          "$ref": "#/$defs/Hash"
        },
        "prepared_message_hash": {
          "$ref": "#/$defs/Hash"
        },
        "execution_commitment_hash": {
          "$ref": "#/$defs/Hash"
        },
        "authorization_id": {
          "$ref": "#/$defs/Identifier"
        },
        "signature": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
        },
        "state": {
          "enum": [
            "requested",
            "preparing",
            "simulated",
            "authorized",
            "signing",
            "submitted",
            "confirming",
            "reconciling",
            "completed",
            "failed",
            "needs_recovery",
            "needs_review",
            "rejected"
          ]
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "SettlementReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_id",
        "execution_request_id",
        "obligation_id",
        "channel_id",
        "voucher_hash",
        "transaction_signature",
        "slot",
        "settled_amount_base_units",
        "settled_total_after_base_units",
        "vault_balance_after_base_units",
        "reconciliation_status",
        "observed_at",
        "receipt_hash"
      ],
      "properties": {
        "type": {
          "const": "settlement_receipt"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "settlement_id": {
          "$ref": "#/$defs/Identifier"
        },
        "execution_request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "obligation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "voucher_hash": {
          "$ref": "#/$defs/Hash"
        },
        "transaction_signature": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
        },
        "slot": {
          "type": "integer",
          "minimum": 0
        },
        "settled_amount_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "settled_total_after_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "vault_balance_after_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "reconciliation_status": {
          "enum": [
            "pending",
            "l1_verified",
            "l2_verified",
            "l3_verified",
            "disputed"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "receipt_hash": {
          "$ref": "#/$defs/Hash"
        }
      }
    }
  }
}
