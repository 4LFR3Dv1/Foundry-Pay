{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.pay/schemas/channel/settlement.v1.schema.json",
  "title": "Foundry Channels settlement objects",
  "oneOf": [
    {
      "$ref": "#/$defs/SettlementRequest"
    },
    {
      "$ref": "#/$defs/SettlementExecution"
    },
    {
      "$ref": "#/$defs/SettlementReceipt"
    },
    {
      "$ref": "#/$defs/ReferenceSettlementRequest"
    },
    {
      "$ref": "#/$defs/SettlementExecutionCommitment"
    },
    {
      "$ref": "#/$defs/SettlementJournalEntry"
    },
    {
      "$ref": "#/$defs/TechnicalExecutionReceipt"
    },
    {
      "$ref": "#/$defs/SettlementObservation"
    },
    {
      "$ref": "#/$defs/ReconciledSettlementReceipt"
    },
    {
      "$ref": "#/$defs/SettlementRecoveryRecord"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Pubkey": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "SettlementRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_id",
        "execution_request_id",
        "obligation_id",
        "channel_id",
        "channel_account",
        "epoch",
        "voucher_sequence",
        "voucher_hash",
        "mint",
        "recipient_wallet",
        "requested_amount_base_units",
        "settled_total_before_base_units",
        "settled_total_after_base_units",
        "activated_authorized_total_base_units",
        "requested_at",
        "expires_at"
      ],
      "properties": {
        "type": {
          "const": "settlement_request"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "settlement_id": {
          "$ref": "#/$defs/Identifier"
        },
        "execution_request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "obligation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_account": {
          "$ref": "#/$defs/Pubkey"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "voucher_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "voucher_hash": {
          "$ref": "#/$defs/Hash"
        },
        "mint": {
          "$ref": "#/$defs/Pubkey"
        },
        "recipient_wallet": {
          "$ref": "#/$defs/Pubkey"
        },
        "requested_amount_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "settled_total_before_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "settled_total_after_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "activated_authorized_total_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "requested_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "SettlementExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_id",
        "execution_request_id",
        "economic_plan_hash",
        "prepared_message_hash",
        "execution_commitment_hash",
        "authorization_id",
        "state",
        "updated_at"
      ],
      "properties": {
        "type": {
          "const": "settlement_execution"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "settlement_id": {
          "$ref": "#/$defs/Identifier"
        },
        "execution_request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "economic_plan_hash": {
          "$ref": "#/$defs/Hash"
        },
        "prepared_message_hash": {
          "$ref": "#/$defs/Hash"
        },
        "execution_commitment_hash": {
          "$ref": "#/$defs/Hash"
        },
        "authorization_id": {
          "$ref": "#/$defs/Identifier"
        },
        "signature": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
        },
        "state": {
          "enum": [
            "requested",
            "preparing",
            "simulated",
            "authorized",
            "signing",
            "submitted",
            "confirming",
            "reconciling",
            "completed",
            "failed",
            "needs_recovery",
            "needs_review",
            "rejected"
          ]
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "SettlementReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_id",
        "execution_request_id",
        "obligation_id",
        "channel_id",
        "voucher_hash",
        "transaction_signature",
        "slot",
        "settled_amount_base_units",
        "settled_total_after_base_units",
        "vault_balance_after_base_units",
        "reconciliation_status",
        "observed_at",
        "receipt_hash"
      ],
      "properties": {
        "type": {
          "const": "settlement_receipt"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "settlement_id": {
          "$ref": "#/$defs/Identifier"
        },
        "execution_request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "obligation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "voucher_hash": {
          "$ref": "#/$defs/Hash"
        },
        "transaction_signature": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
        },
        "slot": {
          "type": "integer",
          "minimum": 0
        },
        "settled_amount_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "settled_total_after_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "vault_balance_after_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "reconciliation_status": {
          "enum": [
            "pending",
            "l1_verified",
            "l2_verified",
            "l3_verified",
            "disputed"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "receipt_hash": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "ReferenceSettlementRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "environment",
        "network",
        "genesis_hash",
        "program_id",
        "channel_id",
        "channel_account",
        "epoch",
        "mint",
        "recipient_wallet",
        "settlement_id",
        "execution_request_id",
        "obligation_id",
        "idempotency_key",
        "requested_base_units",
        "activated_total_before",
        "settled_total_before",
        "vault_balance_before",
        "channel_snapshot_hash",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "type": {"const": "settlement_request"},
        "protocol_version": {"const": "1.0.0"},
        "environment": {"const": "devnet"},
        "network": {"const": "solana:devnet"},
        "genesis_hash": {"$ref": "#/$defs/Pubkey"},
        "program_id": {"$ref": "#/$defs/Pubkey"},
        "channel_id": {"$ref": "#/$defs/Identifier"},
        "channel_account": {"$ref": "#/$defs/Pubkey"},
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mint": {"$ref": "#/$defs/Pubkey"},
        "recipient_wallet": {"$ref": "#/$defs/Pubkey"},
        "settlement_id": {"$ref": "#/$defs/Identifier"},
        "execution_request_id": {"$ref": "#/$defs/Identifier"},
        "obligation_id": {"$ref": "#/$defs/Identifier"},
        "idempotency_key": {"$ref": "#/$defs/Identifier"},
        "requested_base_units": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "activated_total_before": {"$ref": "#/$defs/Amount"},
        "settled_total_before": {"$ref": "#/$defs/Amount"},
        "vault_balance_before": {"$ref": "#/$defs/Amount"},
        "channel_snapshot_hash": {"$ref": "#/$defs/Hash"},
        "created_at": {"$ref": "#/$defs/Timestamp"},
        "expires_at": {"$ref": "#/$defs/Timestamp"}
      }
    },
    "SettlementExecutionCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_request_hash",
        "execution_request_id",
        "execution_commitment_hash",
        "prepared_message_hash",
        "executor_id",
        "expected_signer",
        "expires_at",
        "commitment_hash"
      ],
      "properties": {
        "type": {"const": "settlement_execution_commitment"},
        "protocol_version": {"const": "1.0.0"},
        "settlement_request_hash": {"$ref": "#/$defs/Hash"},
        "execution_request_id": {"$ref": "#/$defs/Identifier"},
        "execution_commitment_hash": {"$ref": "#/$defs/Hash"},
        "prepared_message_hash": {"$ref": "#/$defs/Hash"},
        "executor_id": {"$ref": "#/$defs/Identifier"},
        "expected_signer": {"$ref": "#/$defs/Pubkey"},
        "expires_at": {"$ref": "#/$defs/Timestamp"},
        "commitment_hash": {"$ref": "#/$defs/Hash"}
      }
    },
    "SettlementJournalEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_id",
        "sequence",
        "state",
        "event_type",
        "payload",
        "payload_hash",
        "previous_event_hash",
        "event_hash",
        "recorded_at"
      ],
      "properties": {
        "type": {"const": "settlement_journal_entry"},
        "protocol_version": {"const": "1.0.0"},
        "settlement_id": {"$ref": "#/$defs/Identifier"},
        "sequence": {"type": "integer", "minimum": 1},
        "state": {
          "enum": [
            "requested",
            "validated",
            "execution_committed",
            "authorized",
            "submitted",
            "confirming",
            "reconciling",
            "completed",
            "rejected",
            "failed_before_submission",
            "needs_recovery",
            "needs_review",
            "disputed"
          ]
        },
        "event_type": {"$ref": "#/$defs/Identifier"},
        "payload": {"type": "object"},
        "payload_hash": {"$ref": "#/$defs/Hash"},
        "previous_event_hash": {"$ref": "#/$defs/Hash"},
        "event_hash": {"$ref": "#/$defs/Hash"},
        "recorded_at": {"$ref": "#/$defs/Timestamp"}
      }
    },
    "TechnicalExecutionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_id",
        "execution_request_id",
        "execution_commitment_hash",
        "prepared_message_hash",
        "outcome",
        "signature_status",
        "technical_status",
        "observed_at"
      ],
      "properties": {
        "type": {"const": "technical_execution_receipt"},
        "protocol_version": {"const": "1.0.0"},
        "settlement_id": {"$ref": "#/$defs/Identifier"},
        "execution_request_id": {"$ref": "#/$defs/Identifier"},
        "execution_commitment_hash": {"$ref": "#/$defs/Hash"},
        "prepared_message_hash": {"$ref": "#/$defs/Hash"},
        "outcome": {"enum": ["accepted", "rejected", "unknown"]},
        "signature_status": {"enum": ["known", "unknown"]},
        "transaction_signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "technical_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "executor_receipt_hash": {"$ref": "#/$defs/Hash"},
        "observed_at": {"$ref": "#/$defs/Timestamp"}
      }
    },
    "SettlementObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "source_id",
        "channel_id",
        "channel_account",
        "epoch",
        "mint",
        "destination",
        "transaction_signature",
        "settled_total_before",
        "settled_total_after",
        "vault_balance_before",
        "vault_balance_after",
        "recipient_balance_before",
        "recipient_balance_after",
        "observed_at",
        "observation_hash"
      ],
      "properties": {
        "type": {"const": "settlement_observation"},
        "protocol_version": {"const": "1.0.0"},
        "source_id": {"$ref": "#/$defs/Identifier"},
        "channel_id": {"$ref": "#/$defs/Identifier"},
        "channel_account": {"$ref": "#/$defs/Pubkey"},
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mint": {"$ref": "#/$defs/Pubkey"},
        "destination": {"$ref": "#/$defs/Pubkey"},
        "transaction_signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "settled_total_before": {"$ref": "#/$defs/Amount"},
        "settled_total_after": {"$ref": "#/$defs/Amount"},
        "vault_balance_before": {"$ref": "#/$defs/Amount"},
        "vault_balance_after": {"$ref": "#/$defs/Amount"},
        "recipient_balance_before": {"$ref": "#/$defs/Amount"},
        "recipient_balance_after": {"$ref": "#/$defs/Amount"},
        "observed_at": {"$ref": "#/$defs/Timestamp"},
        "observation_hash": {"$ref": "#/$defs/Hash"}
      }
    },
    "ReconciledSettlementReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_id",
        "settlement_request_hash",
        "execution_request_id",
        "obligation_id",
        "channel_id",
        "channel_account",
        "epoch",
        "mint",
        "destination",
        "requested_base_units",
        "settled_total_before",
        "settled_total_after",
        "vault_balance_before",
        "vault_balance_after",
        "transaction_signature",
        "observation_hashes",
        "reconciliation_status",
        "completed_at",
        "receipt_hash"
      ],
      "properties": {
        "type": {"const": "reconciled_settlement_receipt"},
        "protocol_version": {"const": "1.0.0"},
        "settlement_id": {"$ref": "#/$defs/Identifier"},
        "settlement_request_hash": {"$ref": "#/$defs/Hash"},
        "execution_request_id": {"$ref": "#/$defs/Identifier"},
        "obligation_id": {"$ref": "#/$defs/Identifier"},
        "channel_id": {"$ref": "#/$defs/Identifier"},
        "channel_account": {"$ref": "#/$defs/Pubkey"},
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mint": {"$ref": "#/$defs/Pubkey"},
        "destination": {"$ref": "#/$defs/Pubkey"},
        "requested_base_units": {"$ref": "#/$defs/Amount"},
        "settled_total_before": {"$ref": "#/$defs/Amount"},
        "settled_total_after": {"$ref": "#/$defs/Amount"},
        "vault_balance_before": {"$ref": "#/$defs/Amount"},
        "vault_balance_after": {"$ref": "#/$defs/Amount"},
        "transaction_signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observation_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Hash"}
        },
        "reconciliation_status": {"const": "reference_observation_matched"},
        "completed_at": {"$ref": "#/$defs/Timestamp"},
        "receipt_hash": {"$ref": "#/$defs/Hash"}
      }
    },
    "SettlementRecoveryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "settlement_id",
        "attempt",
        "outcome",
        "submit_intent_count",
        "automatic_second_submission_count",
        "observed_at",
        "recovery_hash"
      ],
      "properties": {
        "type": {"const": "settlement_recovery_record"},
        "protocol_version": {"const": "1.0.0"},
        "settlement_id": {"$ref": "#/$defs/Identifier"},
        "attempt": {"type": "integer", "minimum": 1},
        "outcome": {
          "enum": [
            "confirmed",
            "failed_before_broadcast",
            "unknown",
            "provider_divergence",
            "invalid_status_response"
          ]
        },
        "executor_id": {"$ref": "#/$defs/Identifier"},
        "status_response_hash": {"$ref": "#/$defs/Hash"},
        "transaction_signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "submit_intent_count": {"const": 1},
        "automatic_second_submission_count": {"const": 0},
        "observed_at": {"$ref": "#/$defs/Timestamp"},
        "detail": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {"type": "string", "minLength": 1, "maxLength": 256},
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/Identifier"}
              }
            ]
          }
        },
        "recovery_hash": {"$ref": "#/$defs/Hash"}
      }
    }
  }
}
