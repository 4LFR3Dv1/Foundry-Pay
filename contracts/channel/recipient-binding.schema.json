{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.pay/schemas/channel/recipient-binding.v1.schema.json",
  "title": "Foundry Channels recipient binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "payload",
    "binding_hash",
    "claim_key_signature",
    "destination_wallet_signature"
  ],
  "properties": {
    "type": {
      "const": "recipient_binding"
    },
    "protocol_version": {
      "const": "1.0.0"
    },
    "payload": {
      "$ref": "#/$defs/RecipientBindingPayload"
    },
    "binding_hash": {
      "$ref": "#/$defs/Hash"
    },
    "claim_key_signature": {
      "$ref": "#/$defs/Signature"
    },
    "destination_wallet_signature": {
      "$ref": "#/$defs/Signature"
    },
    "current_wallet_signature": {
      "$ref": "#/$defs/Signature"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "binding_mode": {
                "const": "rebind"
              }
            },
            "required": [
              "binding_mode"
            ]
          }
        }
      },
      "then": {
        "required": [
          "current_wallet_signature"
        ]
      },
      "else": {
        "not": {
          "required": [
            "current_wallet_signature"
          ]
        }
      }
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Pubkey": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Signature": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "RecipientBindingPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "protocol_version",
        "environment",
        "network",
        "genesis_hash",
        "program_id",
        "channel_id",
        "channel_account",
        "epoch",
        "claim_id",
        "claim_pubkey",
        "binding_mode",
        "destination_wallet",
        "binding_nonce",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "domain": {
          "const": "foundry.channels.recipient-binding"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "environment": {
          "const": "devnet"
        },
        "network": {
          "const": "solana:devnet"
        },
        "genesis_hash": {
          "$ref": "#/$defs/Pubkey"
        },
        "program_id": {
          "$ref": "#/$defs/Pubkey"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_account": {
          "$ref": "#/$defs/Pubkey"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "claim_id": {
          "$ref": "#/$defs/Identifier"
        },
        "claim_pubkey": {
          "$ref": "#/$defs/Pubkey"
        },
        "binding_mode": {
          "enum": [
            "initial",
            "rebind"
          ]
        },
        "current_wallet": {
          "$ref": "#/$defs/Pubkey"
        },
        "destination_wallet": {
          "$ref": "#/$defs/Pubkey"
        },
        "binding_nonce": {
          "type": "integer",
          "minimum": 1
        },
        "issued_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "binding_mode": {
                "const": "rebind"
              }
            }
          },
          "then": {
            "required": [
              "current_wallet"
            ]
          },
          "else": {
            "not": {
              "required": [
                "current_wallet"
              ]
            }
          }
        }
      ]
    }
  }
}
