{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.pay/schemas/channel/channel.v1.schema.json",
  "title": "Foundry Channels core objects",
  "oneOf": [
    {
      "$ref": "#/$defs/Channel"
    },
    {
      "$ref": "#/$defs/ChannelFunding"
    },
    {
      "$ref": "#/$defs/ChannelParticipant"
    },
    {
      "$ref": "#/$defs/ChannelPolicy"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Pubkey": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "$comment": "Canonical unsigned u64 decimal, 0 through 18446744073709551615."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ChannelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "channel_id",
        "max_cumulative_authorized_base_units",
        "allow_partial_settlement",
        "allow_top_up",
        "minimum_close_grace_seconds",
        "rebind_mode"
      ],
      "properties": {
        "type": {
          "const": "channel_policy"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "max_cumulative_authorized_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "allow_partial_settlement": {
          "const": true
        },
        "allow_top_up": {
          "type": "boolean"
        },
        "minimum_close_grace_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "rebind_mode": {
          "enum": [
            "disabled",
            "current_and_new_wallet"
          ]
        }
      }
    },
    "ChannelParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "channel_id",
        "role",
        "authority"
      ],
      "properties": {
        "type": {
          "const": "channel_participant"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "role": {
          "enum": [
            "sender",
            "recipient_claim_key",
            "recipient_wallet"
          ]
        },
        "authority": {
          "$ref": "#/$defs/Pubkey"
        }
      }
    },
    "ChannelFunding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "funding_id",
        "channel_id",
        "channel_account",
        "mint",
        "amount_base_units",
        "funded_total_after_base_units",
        "transaction_signature",
        "observed_slot",
        "observed_at"
      ],
      "properties": {
        "type": {
          "const": "channel_funding"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "funding_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_account": {
          "$ref": "#/$defs/Pubkey"
        },
        "mint": {
          "$ref": "#/$defs/Pubkey"
        },
        "amount_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "funded_total_after_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "transaction_signature": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
        },
        "observed_slot": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "account_version",
        "environment",
        "network",
        "genesis_hash",
        "program_id",
        "channel_id",
        "channel_account",
        "epoch",
        "sender",
        "recipient_claim_pubkey",
        "mint",
        "decimals",
        "vault_token_account",
        "funded_total_base_units",
        "activated_authorized_total_base_units",
        "settled_total_base_units",
        "refunded_total_base_units",
        "latest_activated_sequence",
        "latest_activated_voucher_hash",
        "status",
        "expires_at",
        "policy",
        "created_at",
        "updated_at"
      ],
      "dependentRequired": {
        "close_requested_at": [
          "claim_deadline"
        ],
        "claim_deadline": [
          "close_requested_at"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "closing",
                  "closed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "close_requested_at",
              "claim_deadline"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "draft",
                  "funding",
                  "active",
                  "settling",
                  "expired"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "close_requested_at"
                  ]
                },
                {
                  "required": [
                    "claim_deadline"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "settling"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "recipient_wallet"
            ]
          }
        }
      ],
      "properties": {
        "type": {
          "const": "channel"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "account_version": {
          "const": 1
        },
        "environment": {
          "const": "devnet"
        },
        "network": {
          "const": "solana:devnet"
        },
        "genesis_hash": {
          "$ref": "#/$defs/Pubkey"
        },
        "program_id": {
          "$ref": "#/$defs/Pubkey"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_account": {
          "$ref": "#/$defs/Pubkey"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "sender": {
          "$ref": "#/$defs/Pubkey"
        },
        "recipient_claim_pubkey": {
          "$ref": "#/$defs/Pubkey"
        },
        "recipient_wallet": {
          "$ref": "#/$defs/Pubkey"
        },
        "mint": {
          "$ref": "#/$defs/Pubkey"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "vault_token_account": {
          "$ref": "#/$defs/Pubkey"
        },
        "funded_total_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "activated_authorized_total_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "settled_total_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "refunded_total_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "latest_activated_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "latest_activated_voucher_hash": {
          "$ref": "#/$defs/Hash"
        },
        "status": {
          "enum": [
            "draft",
            "funding",
            "active",
            "settling",
            "closing",
            "closed",
            "expired",
            "blocked",
            "disputed",
            "needs_recovery",
            "needs_review"
          ]
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "close_requested_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "claim_deadline": {
          "$ref": "#/$defs/Timestamp"
        },
        "policy": {
          "$ref": "#/$defs/ChannelPolicy"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    }
  }
}
