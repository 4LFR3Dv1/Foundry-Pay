{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.pay/schemas/channel/channel-voucher.v1.schema.json",
  "title": "Foundry Channels cumulative signed voucher",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "payload",
    "voucher_hash",
    "sender_signature"
  ],
  "properties": {
    "type": {
      "const": "channel_voucher"
    },
    "protocol_version": {
      "const": "1.0.0"
    },
    "payload": {
      "$ref": "#/$defs/ChannelVoucherPayload"
    },
    "voucher_hash": {
      "$ref": "#/$defs/Hash"
    },
    "sender_signature": {
      "$ref": "#/$defs/Signature"
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Pubkey": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Signature": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
    },
    "Amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "$comment": "Canonical unsigned u64 decimal, 0 through 18446744073709551615."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ChannelVoucherPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "protocol_version",
        "environment",
        "network",
        "genesis_hash",
        "program_id",
        "channel_id",
        "channel_account",
        "epoch",
        "sequence",
        "previous_activated_voucher_hash",
        "sender",
        "recipient_claim_pubkey",
        "mint",
        "cumulative_authorized_base_units",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "domain": {
          "const": "foundry.channels.voucher"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "environment": {
          "const": "devnet"
        },
        "network": {
          "const": "solana:devnet"
        },
        "genesis_hash": {
          "$ref": "#/$defs/Pubkey"
        },
        "program_id": {
          "$ref": "#/$defs/Pubkey"
        },
        "channel_id": {
          "$ref": "#/$defs/Identifier"
        },
        "channel_account": {
          "$ref": "#/$defs/Pubkey"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previous_activated_voucher_hash": {
          "$ref": "#/$defs/Hash"
        },
        "sender": {
          "$ref": "#/$defs/Pubkey"
        },
        "recipient_claim_pubkey": {
          "$ref": "#/$defs/Pubkey"
        },
        "mint": {
          "$ref": "#/$defs/Pubkey"
        },
        "cumulative_authorized_base_units": {
          "$ref": "#/$defs/Amount"
        },
        "issued_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    }
  }
}
